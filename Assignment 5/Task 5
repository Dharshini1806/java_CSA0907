import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardOpenOption;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
 
public class PassStore {
 
    private final Path file;
 
    PassStore(Path file) { this.file = file; }
 
    public void add(String passId, String regNo, String name, int route, double amount) throws IOException {
        try (BufferedWriter w = Files.newBufferedWriter(file,
                StandardOpenOption.CREATE, StandardOpenOption.APPEND)) {
            w.write(String.join(",", passId, regNo, name,
                    String.valueOf(route), String.valueOf(amount)));
            w.newLine();
        }
    }
 
    /** Returns the five fields of the pass with the given ID, or null if not found. */
    public String[] find(String passId) throws IOException {
        // TODO 1 (completed): read line by line with a BufferedReader inside
        // try-with-resources; skip damaged lines (not exactly 5 fields); return
        // the fields of the matching pass.
        try (BufferedReader r = Files.newBufferedReader(file)) {
            String line;
            while ((line = r.readLine()) != null) {
                String[] f = line.split(",", -1);   // -1 keeps trailing empty fields
                if (f.length != 5 || isDamaged(f)) continue;   // damaged line: skip it
                if (f[0].equals(passId)) return f;
            }
        }
        return null;
    }
 
    /** A line cut off right after a comma still has 5 fields but one is empty (found by test T3c). */
    private static boolean isDamaged(String[] f) {
        for (String x : f) if (x.isBlank()) return true;
        try {                                   // found by Task B2: route and amount must be numeric
            Integer.parseInt(f[3].trim());
            Double.parseDouble(f[4].trim());
        } catch (NumberFormatException e) { return true; }
        return false;
    }
 
    /** Extra operation from Task A1 (iii): all valid passes on a route. */
    public List<String[]> listByRoute(int route) throws IOException {
        List<String[]> out = new ArrayList<>();
        try (BufferedReader r = Files.newBufferedReader(file)) {
            String line;
            while ((line = r.readLine()) != null) {
                String[] f = line.split(",", -1);
                if (f.length != 5 || isDamaged(f)) continue;
                try {
                    Double.parseDouble(f[4]);                    // amount must be numeric
                    if (Integer.parseInt(f[3].trim()) == route) out.add(f);
                } catch (NumberFormatException e) { /* damaged numeric field: skip */ }
            }
        }
        return out;
    }
 
    public static void main(String[] args) throws IOException {
        Path f = Files.createTempFile("passes", ".csv");
        PassStore store = new PassStore(f);
        store.add("P1001", "192311001", "Arun", 12, 4500);
        Files.writeString(f, "P1002,DAMAGED LINE\n", StandardOpenOption.APPEND);
        store.add("P1003", "192311003", "Divya", 7, 3800);
        System.out.println(Arrays.toString(store.find("P1003")));
        System.out.println(Arrays.toString(store.find("P1002")));
        Files.delete(f);
    }
}


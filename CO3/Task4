class ScannerTask implements Runnable {
    private final int station;
    private final int scripts;
    private int scanned;
 
    ScannerTask(int station, int scripts) {
        this.station = station;
        this.scripts = scripts;
    }
 
    public void run() {
        try {
            for (int i = 0; i < scripts; i++) {
                Thread.sleep(100);
                scanned++;
            }
            System.out.println("Station " + station
                    + " scanned " + scanned + " scripts");
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            System.out.println("Station " + station + " interrupted");
        }
    }
 
    int getScanned() { return scanned; }
}
 
class ThreadStation extends Thread {
    private final int station;
    ThreadStation(int station) { this.station = station; }
 
    public void run() {
        try {
            Thread.sleep(150);
            System.out.println("Thread station " + station
                    + " completed 3 scripts");
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
    }
}
 
public class ScannerStations {
    public static void main(String[] args) throws InterruptedException {
        ThreadStation t1 = new ThreadStation(1);
        ThreadStation t2 = new ThreadStation(2);
        t1.start();
        t2.start();
 
        ScannerTask[] tasks = new ScannerTask[4];
        Thread[] workers = new Thread[4];
 
        for (int i = 0; i < 4; i++) {
            tasks[i] = new ScannerTask(i + 1, 5);
            workers[i] = new Thread(tasks[i]);
            workers[i].start();
        }
 
        System.out.println("Station 1 alive? " + t1.isAlive());
        t1.join();
        t2.join();
        for (Thread worker : workers) worker.join();
 
        int total = 0;
        for (ScannerTask task : tasks) total += task.getScanned();
        System.out.println("Runnable stations total: " + total);
        System.out.println("All stations completed.");
    }
}
